---
import { workouts, exerciseGuide } from '../data/workouts';
import { DAY_LABELS, DEFAULT_GOAL } from '../lib/progress';
import { DEFAULT_REST, DEFAULT_WORK, INTERVAL_OPTIONS } from '../lib/timer';

const site = Astro.site ?? new URL('https://gerak.pages.dev');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.png', site).href;
const description = 'Program workout di rumah tanpa alat. Pilih latihan, nyalakan timer, dan pantau progresmu.';
const shareText = 'Workout rumahan tanpa alat, lengkap dengan timer dan progres.';
const durations = workouts.map(workout => workout.duration);
const durationRange = `${Math.min(...durations)}–${Math.max(...durations)}`;
const exerciseCount = Object.keys(exerciseGuide).length;
const dayLabels = DAY_LABELS;
const intervalOptions = INTERVAL_OPTIONS;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="color-scheme" content="light dark" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="theme-color" content="#18201a" />
		<meta name="theme-color" content="#141810" media="(prefers-color-scheme: dark)" />
		<meta property="og:title" content="GERAK — Workout di Rumah" />
		<meta property="og:description" content={shareText} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="GERAK" />
		<meta property="og:locale" content="id_ID" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="GERAK — workout di rumah tanpa alat" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="GERAK — Workout di Rumah" />
		<meta name="twitter:description" content={shareText} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="generator" content={Astro.generator} />
		<title>GERAK — Workout di Rumah</title>
		<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'GERAK', description: 'Program workout di rumah tanpa alat', inLanguage: 'id-ID' })}></script>
	</head>
	<body>
		<header class="nav wrap">
			<a class="brand" href="#top" aria-label="GERAK beranda"><span>G</span>GERAK</a>
			<nav aria-label="Navigasi utama"><a href="#program">Program</a><a href="#cara">Cara mulai</a><a href="#progres">Progres</a></nav>
			<a class="nav-cta" href="#program">Mulai latihan <span aria-hidden="true">↗</span></a>
		</header>

		<main id="top">
			<section class="hero wrap">
				<div class="hero-copy">
					<p class="eyebrow"><span></span> Gerak sekarang, bukan nanti</p>
					<h1>Badan lebih kuat.<br /><em>Dari rumah.</em></h1>
					<p class="lead">Workout efektif tanpa alat, tanpa biaya, tanpa alasan. Pilih program dan mulai bergerak dalam hitungan detik.</p>
					<div class="hero-actions"><a class="button primary" href="#program">Lihat program <span>↓</span></a><button class="button ghost" id="quick-start" type="button"><span class="play">▶</span> <span id="quick-start-label">Latihan cepat</span></button></div>
					<div class="trust"><div class="faces" aria-hidden="true"><span>{workouts.length}</span><span>{exerciseCount}</span><span>0</span><span>✓</span></div><p><strong>{workouts.length} program, {exerciseCount} gerakan</strong><br />tanpa alat, tanpa biaya</p></div>
				</div>
				<div class="hero-visual" aria-label="Ilustrasi latihan squat">
					<div class="sun"></div><div class="figure"><div class="head"></div><div class="hair"></div><div class="body"></div><div class="arm left"></div><div class="arm right"></div><div class="leg left"></div><div class="leg right"></div></div>
					<div class="stat stat-time"><span>◷</span><div><strong>{durationRange}</strong><small>MENIT / SESI</small></div></div><div class="stat stat-place"><span>⌂</span><div><strong>0</strong><small>ALAT DIBUTUHKAN</small></div></div><p class="scribble">ruang kecil,<br /><b>hasil besar!</b></p>
				</div>
			</section>

			<section class="ticker" aria-label="Keunggulan"><div>LATIHAN GRATIS <b>✦</b> TANPA ALAT <b>✦</b> SEMUA LEVEL <b>✦</b> BISA DI MANA SAJA <b>✦</b> LATIHAN GRATIS <b>✦</b> TANPA ALAT</div></section>

			<section class="programs wrap" id="program">
				<div class="section-head"><div><p class="eyebrow"><span></span> Pilih ritmemu</p><h2>Program latihan</h2></div><p>Tak perlu sempurna. Cukup mulai dari level yang terasa pas hari ini.</p></div>
				<div class="filters" role="group" aria-label="Filter program"><button class="active" data-filter="Semua" type="button">Semua</button><button data-filter="Pemula" type="button">Pemula</button><button data-filter="Menengah" type="button">Menengah</button><button data-filter="Lanjutan" type="button">Lanjutan</button></div>
				<div class="grid">
					{workouts.map((workout, index) => (
						<article class={`card ${workout.color}`} data-level={workout.level} data-id={workout.id}>
							<div class="card-top"><span class="number">0{index + 1}</span><span class="tag">{workout.level}</span></div><div class="mini-figure" aria-hidden="true"><span></span><i></i><b></b></div>
							<div class="card-body"><p>{workout.focus}</p><h3>{workout.title}</h3><div class="meta"><span>◷ ≈ {workout.duration} menit</span><span>↻ {workout.rounds} ronde</span></div><div class="card-actions"><button class="details-workout" type="button">Detail</button><button class="start-workout" type="button">Mulai latihan <span>→</span></button></div></div>
						</article>
					))}
				</div>
			</section>

			<section class="how" id="cara"><div class="wrap">
				<div class="section-head light"><div><p class="eyebrow"><span></span> Gampang dimulai</p><h2>Tiga langkah.<br /><em>Langsung keringetan.</em></h2></div></div>
				<div class="steps"><div><b>01</b><span>↙</span><h3>Pilih program</h3><p>Sesuaikan durasi dan level dengan kondisi tubuhmu.</p></div><div><b>02</b><span>▶</span><h3>Ikuti timer</h3><p>Gerak 30 detik, istirahat 15 detik. Ulangi.</p></div><div><b>03</b><span>✓</span><h3>Catat progres</h3><p>Selesaikan latihan dan bangun konsistensi harian.</p></div></div>
			</div></section>

			<section class="progress wrap" id="progres">
				<div><p class="eyebrow"><span></span> Progres minggu ini</p><h2>Konsisten lebih penting<br />daripada sempurna.</h2><p>Setiap latihan selesai otomatis tersimpan di perangkat ini.</p></div>
				<div class="progress-card"><div class="progress-title"><div><small>LATIHAN SELESAI</small><strong id="completed-count">0</strong><span> / <b id="weekly-goal">{DEFAULT_GOAL}</b> minggu ini</span></div><span class="bolt">ϟ</span></div><div class="bar"><span id="progress-bar"></span></div><div class="days">{dayLabels.map((day, index) => <div data-day={index} data-day-name={day} aria-label={day}><i aria-hidden="true">✓</i><span>{day.slice(0, 3)}</span></div>)}</div><div class="progress-stats"><span><b id="streak-count">0</b> hari streak</span><span><b id="total-minutes">0</b> total menit</span></div><div class="progress-controls"><label>Target <select id="goal-select"><option>3</option><option selected>4</option><option>5</option><option>7</option></select> / minggu</label><button id="export-progress" type="button">Export data</button><button id="import-progress" type="button">Import data</button><button id="reset-progress" type="button">Reset</button></div><input id="import-file" type="file" accept="application/json,.json" hidden /><div class="history"><h3>Riwayat terakhir</h3><ul id="history-list"></ul><p id="history-status" role="status" aria-live="polite"></p></div></div>
			</section>
			<section class="safety wrap"><strong>⚠ Dengarkan tubuhmu.</strong><span>Berhenti bila terasa nyeri tajam, pusing, atau sesak. Konsultasikan kondisi medis dengan tenaga kesehatan sebelum mulai.</span></section>
		</main>

		<footer><div class="wrap"><a class="brand" href="#top"><span>G</span>GERAK</a><p>Gerak kecil hari ini. Badan kuat esok hari.</p><div class="footer-actions"><button id="share-site" type="button">Bagikan</button><small>© 2026 GERAK</small></div></div></footer>

		<dialog id="detail-modal"><button class="close close-detail" aria-label="Tutup" type="button">×</button><p class="modal-kicker">TENTANG PROGRAM</p><h2 id="detail-title"></h2><p id="detail-target"></p><div class="program-summary"><span id="detail-duration"></span><span id="detail-rounds"></span></div><div class="detail-box"><strong>Tips program</strong><span id="detail-tip"></span></div><div class="exercise-list" id="exercise-list"></div><div class="modal-actions"><button id="detail-start" class="button primary" type="button">Mulai latihan</button><button id="detail-share" class="button ghost" type="button">Bagikan</button></div></dialog>
		<dialog id="workout-modal"><button class="close" id="close-modal" aria-label="Tutup" type="button">×</button><p class="modal-kicker" id="phase-label">LATIHAN BERLANGSUNG</p><h2 id="modal-title">Full Body Starter</h2><div class="round" id="round-label">Ronde 1 / 3</div><div class="modal-tools"><label class="interval-choice">Interval <select id="interval-choice">{intervalOptions.map(option => <option value={option.value} selected={option.value === `${DEFAULT_WORK},${DEFAULT_REST}`}>{option.label}</option>)}</select></label><button id="mute-toggle" type="button" aria-pressed="false">Suara: aktif</button></div><div class="timer-ring"><svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="53"></circle><circle id="timer-progress" cx="60" cy="60" r="53"></circle></svg><strong id="timer" aria-hidden="true">30</strong><span aria-hidden="true">DETIK</span></div><h3 id="exercise-name">Jumping Jack</h3><p id="timer-status" role="status" aria-live="polite">Siap? Tekan mulai.</p><p class="next-up" id="next-up"></p><details class="active-guide"><summary>Cara melakukan</summary><p id="active-steps"></p><small id="active-avoid"></small></details><div class="modal-actions"><button id="timer-toggle" class="button primary" type="button">Mulai</button><button id="timer-skip" class="button ghost" type="button">Lewati →</button></div><div class="finish-actions" id="finish-actions" hidden><button id="finish-next" class="button ghost" type="button">Program berikutnya</button><button id="finish-share" class="button ghost" type="button">Bagikan hasil</button></div></dialog>

		<script type="application/json" id="gerak-data" set:html={JSON.stringify({ workouts, exerciseGuide }).replace(/</g, '\\u003c')}></script>
		<script>
			import {
				computeStreak, dayIndex, formatShortDate, localDate, mergeHistory, progressPercent,
				sanitizeHistory, totalMinutes, weekKey,
				DEFAULT_GOAL, GOAL_KEY, HISTORY_KEY, LAST_PROGRAM_KEY, LAST_WORKOUT_KEY, MUTE_KEY,
				type HistoryEntry,
			} from '../lib/progress';
			import {
				advance, isFinalSet, nextUpLabel, parseInterval, phaseSeconds,
				DEFAULT_REST, DEFAULT_WORK, READY_SECONDS, type Phase,
			} from '../lib/timer';
			import type { ExerciseGuide, Workout } from '../data/workouts';
			import { createStore } from '../lib/storage';

			interface GerakData {
				workouts: Workout[];
				exerciseGuide: Record<string, ExerciseGuide>;
			}

			const select = <T extends Element>(selector: string): T => {
				const element = document.querySelector<T>(selector);
				if (!element) throw new Error(`GERAK: elemen tidak ditemukan — ${selector}`);
				return element;
			};

			const dataElement = select<HTMLScriptElement>('#gerak-data');
			const { workouts, exerciseGuide } = JSON.parse(dataElement.textContent ?? '{"workouts":[],"exerciseGuide":{}}') as GerakData;

			const modal = select<HTMLDialogElement>('#workout-modal');
			const detailModal = select<HTMLDialogElement>('#detail-modal');
			const timerText = select<HTMLElement>('#timer');
			const timerProgress = select<SVGCircleElement>('#timer-progress');
			const title = select<HTMLElement>('#modal-title');
			const exerciseName = select<HTMLElement>('#exercise-name');
			const roundLabel = select<HTMLElement>('#round-label');
			const status = select<HTMLElement>('#timer-status');
			const nextUp = select<HTMLElement>('#next-up');
			const toggle = select<HTMLButtonElement>('#timer-toggle');
			const phaseLabel = select<HTMLElement>('#phase-label');
			const activeSteps = select<HTMLElement>('#active-steps');
			const activeAvoid = select<HTMLElement>('#active-avoid');
			const intervalChoice = select<HTMLSelectElement>('#interval-choice');
			const skipButton = select<HTMLButtonElement>('#timer-skip');
			const muteToggle = select<HTMLButtonElement>('#mute-toggle');
			const finishActions = select<HTMLElement>('#finish-actions');
			const quickStartLabel = select<HTMLElement>('#quick-start-label');
			const completedCount = select<HTMLElement>('#completed-count');
			const weeklyGoal = select<HTMLElement>('#weekly-goal');
			const goalSelect = select<HTMLSelectElement>('#goal-select');
			const progressBar = select<HTMLElement>('#progress-bar');
			const totalMinutesLabel = select<HTMLElement>('#total-minutes');
			const streakLabel = select<HTMLElement>('#streak-count');
			const historyList = select<HTMLUListElement>('#history-list');
			const historyStatus = select<HTMLElement>('#history-status');
			const importFile = select<HTMLInputElement>('#import-file');
			const dayCells = document.querySelectorAll<HTMLDivElement>('.days div');

			const store = createStore(window.localStorage, () => {
				historyStatus.textContent = 'Penyimpanan browser tidak tersedia; progres hanya bertahan selama halaman ini terbuka.';
			});
			const json = <T,>(key: string, fallback: T): T => store.get<T>(key, fallback);
			const remove = (key: string) => store.remove(key);

			let selected: Workout = workouts[0];
			let interval: ReturnType<typeof setInterval> | undefined;
			let phase: Phase = 'work';
			let seconds = DEFAULT_WORK;
			let exerciseIndex = 0;
			let round = 1;
			let running = false;
			let started = false;
			let workSeconds = DEFAULT_WORK;
			let restSeconds = DEFAULT_REST;
			let endAt = 0;
			let lastSecond = -1;
			let elapsedSeconds = 0;
			let muted = store.get<boolean>(MUTE_KEY, false);
			let wakeLock: WakeLockSentinel | null = null;
			let audioCtx: AudioContext | undefined;

			const readHistory = (): HistoryEntry[] => sanitizeHistory(json<unknown>(HISTORY_KEY, []));

			const beep = (frequency = 880, duration = 0.1) => {
				if (muted) return;
				try {
					audioCtx ??= new AudioContext();
					const osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
					osc.type = 'sine';
					osc.frequency.value = frequency;
					gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
					gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);
					osc.connect(gain).connect(audioCtx.destination);
					osc.start();
					osc.stop(audioCtx.currentTime + duration);
				} catch {}
			};

			const speak = (text: string) => {
				if (muted || !('speechSynthesis' in window)) return;
				speechSynthesis.cancel();
				const utterance = new SpeechSynthesisUtterance(text);
				utterance.lang = 'id-ID';
				speechSynthesis.speak(utterance);
			};

			const requestWakeLock = async () => {
				try { wakeLock = await navigator.wakeLock?.request('screen') ?? null; } catch {}
			};

			const releaseWakeLock = async () => {
				try { await wakeLock?.release(); } catch {}
				wakeLock = null;
			};

			const showExerciseGuide = (name: string) => {
				const guide = exerciseGuide[name];
				if (!guide) return;
				activeSteps.textContent = guide.steps;
				activeAvoid.textContent = `Hindari: ${guide.avoid}`;
			};

			const renderHistory = () => {
				const recent = readHistory().sort((a, b) => b.date.localeCompare(a.date)).slice(0, 5);
				historyList.replaceChildren();
				if (recent.length === 0) {
					const empty = document.createElement('li');
					empty.className = 'empty';
					empty.textContent = 'Belum ada latihan selesai.';
					historyList.append(empty);
					return;
				}
				for (const item of recent) {
					const entry = document.createElement('li');
					const name = document.createElement('strong');
					name.textContent = item.workout;
					const meta = document.createElement('span');
					meta.textContent = `${formatShortDate(item.date)} · ${item.minutes} menit`;
					entry.append(name, meta);
					historyList.append(entry);
				}
			};

			const updateProgress = () => {
				const today = new Date();
				const completed = json<number[]>(weekKey(today), []);
				const history = readHistory();
				const goal = store.get<number>(GOAL_KEY, DEFAULT_GOAL);
				completedCount.textContent = String(completed.length);
				weeklyGoal.textContent = String(goal);
				goalSelect.value = String(goal);
				progressBar.style.width = `${progressPercent(completed.length, goal)}%`;
				dayCells.forEach((day, index) => {
					const done = completed.includes(index);
					day.classList.toggle('done', done);
					const name = day.dataset.dayName ?? '';
					day.setAttribute('aria-label', done ? `${name} selesai` : name);
				});
				totalMinutesLabel.textContent = String(totalMinutes(history));
				streakLabel.textContent = String(computeStreak(history.map(item => item.date), today));
				renderHistory();
			};

			const renderTimer = () => {
				timerText.textContent = String(seconds);
				const total = phaseSeconds(phase, workSeconds, restSeconds);
				timerProgress.style.strokeDashoffset = String(333 - (333 * seconds / total));
			};

			const renderMute = () => {
				muteToggle.textContent = muted ? 'Suara: mati' : 'Suara: aktif';
				muteToggle.setAttribute('aria-pressed', String(muted));
			};

			const saveSession = (minutes: number) => {
				const now = new Date();
				const completed = json<number[]>(weekKey(now), []);
				const todayIndex = dayIndex(now);
				if (!completed.includes(todayIndex)) completed.push(todayIndex);
				store.set(weekKey(now), JSON.stringify(completed));
				store.set(LAST_WORKOUT_KEY, now.toISOString());
				store.set(LAST_PROGRAM_KEY, selected.id);
				const history = readHistory();
				history.push({ date: localDate(now), workout: selected.title, minutes });
				store.set(HISTORY_KEY, JSON.stringify(history));
				updateProgress();
			};

			const finish = () => {
				clearInterval(interval);
				running = false;
				void releaseWakeLock();
				beep(660, 0.35);
				const minutes = Math.max(1, Math.round(elapsedSeconds / 60));
				saveSession(minutes);
				title.textContent = 'Latihan selesai!';
				exerciseName.textContent = 'Kerja bagus.';
				status.textContent = `${minutes} menit tercatat. Satu langkah lebih kuat dari kemarin.`;
				nextUp.textContent = '';
				toggle.textContent = 'Tutup';
				toggle.dataset.finished = 'true';
				skipButton.disabled = true;
				finishActions.hidden = false;
				speak('Latihan selesai. Kerja bagus.');
			};

			const showWork = (announcement?: string) => {
				phase = 'work';
				seconds = workSeconds;
				lastSecond = -1;
				if (running) endAt = Date.now() + seconds * 1000;
				phaseLabel.textContent = 'LATIHAN BERLANGSUNG';
				exerciseName.textContent = selected.exercises[exerciseIndex];
				showExerciseGuide(selected.exercises[exerciseIndex]);
				roundLabel.textContent = `Ronde ${round} / ${selected.rounds}`;
				status.textContent = 'Jaga napas. Kamu bisa.';
				nextUp.textContent = '';
				renderTimer();
				speak(announcement ?? selected.exercises[exerciseIndex]);
			};

			const startRest = () => {
				phase = 'rest';
				seconds = restSeconds;
				lastSecond = -1;
				if (running) endAt = Date.now() + seconds * 1000;
				phaseLabel.textContent = 'ISTIRAHAT';
				exerciseName.textContent = 'Tarik napas';
				status.textContent = 'Siapkan gerakan berikutnya.';
				nextUp.textContent = nextUpLabel(selected.exercises, exerciseIndex, round, selected.rounds);
				renderTimer();
				beep(520, 0.12);
				speak('Istirahat');
			};

			const moveToNextExercise = () => {
				const next = advance(exerciseIndex, round, selected.exercises.length, selected.rounds);
				if (next.done) return finish();
				const roundChanged = next.round !== round;
				exerciseIndex = next.exerciseIndex;
				round = next.round;
				const name = selected.exercises[exerciseIndex];
				showWork(roundChanged ? `Ronde ${round} dari ${selected.rounds}. ${name}` : name);
			};

			const completePhase = () => {
				if (toggle.dataset.finished) return;
				if (phase === 'ready') {
					beep(880, 0.12);
					return showWork();
				}
				if (phase === 'work') {
					elapsedSeconds += workSeconds;
					if (isFinalSet(exerciseIndex, round, selected.exercises.length, selected.rounds)) return finish();
					return startRest();
				}
				elapsedSeconds += restSeconds;
				return moveToNextExercise();
			};

			const tick = () => {
				seconds = Math.max(0, Math.ceil((endAt - Date.now()) / 1000));
				if (seconds !== lastSecond) {
					lastSecond = seconds;
					renderTimer();
					if (seconds > 0 && seconds <= 3) beep(phase === 'work' ? 660 : 520, 0.08);
				}
				if (seconds <= 0) completePhase();
			};

			const pauseLoop = (message = 'Dijeda.') => {
				running = false;
				toggle.textContent = 'Lanjut';
				status.textContent = message;
				clearInterval(interval);
				void releaseWakeLock();
			};

			const runLoop = () => {
				running = true;
				toggle.textContent = 'Jeda';
				void requestWakeLock();
				interval = setInterval(tick, 250);
			};

			const startSession = () => {
				started = true;
				phase = 'ready';
				seconds = READY_SECONDS;
				lastSecond = -1;
				endAt = Date.now() + seconds * 1000;
				phaseLabel.textContent = 'BERSIAP';
				exerciseName.textContent = selected.exercises[exerciseIndex];
				showExerciseGuide(selected.exercises[exerciseIndex]);
				status.textContent = `Mulai dalam ${READY_SECONDS} detik.`;
				nextUp.textContent = '';
				renderTimer();
			};

			const openWorkout = (id: string) => {
				selected = workouts.find(item => item.id === id) ?? workouts[0];
				clearInterval(interval);
				running = false;
				started = false;
				void releaseWakeLock();
				phase = 'work';
				seconds = workSeconds;
				lastSecond = -1;
				elapsedSeconds = 0;
				exerciseIndex = 0;
				round = 1;
				title.textContent = selected.title;
				phaseLabel.textContent = 'LATIHAN BERLANGSUNG';
				exerciseName.textContent = selected.exercises[0];
				showExerciseGuide(selected.exercises[0]);
				roundLabel.textContent = `Ronde 1 / ${selected.rounds}`;
				status.textContent = 'Siap? Tekan mulai.';
				nextUp.textContent = '';
				toggle.textContent = 'Mulai';
				skipButton.disabled = false;
				finishActions.hidden = true;
				delete toggle.dataset.finished;
				renderTimer();
				modal.showModal();
			};

			const showDetail = (id: string) => {
				const item = workouts.find(workout => workout.id === id);
				if (!item) return;
				detailModal.dataset.id = id;
				select<HTMLElement>('#detail-title').textContent = item.title;
				select<HTMLElement>('#detail-target').textContent = `Target utama: ${item.target}`;
				select<HTMLElement>('#detail-tip').textContent = item.tip;
				select<HTMLElement>('#detail-duration').textContent = `◷ ≈ ${item.duration} menit`;
				select<HTMLElement>('#detail-rounds').textContent = `↻ ${item.rounds} ronde`;
				select<HTMLElement>('#exercise-list').innerHTML = item.exercises.map((name, index) => {
					const guide = exerciseGuide[name];
					if (!guide) return '';
					return `<details><summary><b>0${index + 1}</b><span><strong>${name}</strong><small>${guide.target}</small></span></summary><div class="exercise-guide"><p>${guide.steps}</p><p><b>Napas:</b> ${guide.breath}</p><p><b>Hindari:</b> ${guide.avoid}</p><p><b>Modifikasi:</b> ${guide.easier}</p></div></details>`;
				}).join('');
				detailModal.showModal();
			};

			const share = async (text: string) => {
				try {
					if (navigator.share) await navigator.share({ title: 'GERAK', text, url: location.href });
					else await navigator.clipboard?.writeText(`${text} ${location.href}`);
				} catch {}
			};

			document.querySelectorAll<HTMLButtonElement>('.start-workout').forEach(button => {
				button.addEventListener('click', () => {
					const id = button.closest<HTMLElement>('.card')?.dataset.id;
					if (id) openWorkout(id);
				});
			});
			document.querySelectorAll<HTMLButtonElement>('.details-workout').forEach(button => {
				button.addEventListener('click', () => {
					const id = button.closest<HTMLElement>('.card')?.dataset.id;
					if (id) showDetail(id);
				});
			});
			select<HTMLButtonElement>('#quick-start').addEventListener('click', () => openWorkout(selected.id));
			select<HTMLButtonElement>('#close-modal').addEventListener('click', () => { clearInterval(interval); running = false; modal.close(); });
			select<HTMLButtonElement>('.close-detail').addEventListener('click', () => detailModal.close());
			select<HTMLButtonElement>('#detail-start').addEventListener('click', () => { detailModal.close(); openWorkout(detailModal.dataset.id ?? ''); });
			select<HTMLButtonElement>('#detail-share').addEventListener('click', () => {
				void share(`Coba program ${select<HTMLElement>('#detail-title').textContent ?? ''} di GERAK`);
			});
			skipButton.addEventListener('click', completePhase);
			select<HTMLButtonElement>('#finish-share').addEventListener('click', () => {
				void share(`Selesai ${selected.title} di GERAK`);
			});
			select<HTMLButtonElement>('#finish-next').addEventListener('click', () => {
				const index = workouts.findIndex(workout => workout.id === selected.id);
				const next = workouts[(index + 1) % workouts.length];
				openWorkout(next.id);
			});
			muteToggle.addEventListener('click', () => {
				muted = !muted;
				store.set(MUTE_KEY, String(muted));
				if (muted) speechSynthesis?.cancel();
				renderMute();
			});
			intervalChoice.addEventListener('change', () => {
				[workSeconds, restSeconds] = parseInterval(intervalChoice.value);
				if (!running && !started) { phase = 'work'; seconds = workSeconds; lastSecond = -1; renderTimer(); }
			});
			toggle.addEventListener('click', () => {
				if (toggle.dataset.finished) { modal.close(); return; }
				if (running) { pauseLoop(); return; }
				if (!started) { startSession(); runLoop(); return; }
				endAt = Date.now() + seconds * 1000;
				status.textContent = 'Terus bergerak!';
				runLoop();
			});
			modal.addEventListener('close', () => {
				clearInterval(interval);
				running = false;
				void releaseWakeLock();
				speechSynthesis?.cancel();
			});
			document.addEventListener('keydown', event => {
				if (event.key === ' ' && modal.open) { event.preventDefault(); toggle.click(); }
			});
			document.addEventListener('visibilitychange', () => {
				if (document.visibilityState === 'hidden' && running) { pauseLoop('Dijeda otomatis: tab tidak aktif.'); return; }
				if (document.visibilityState === 'visible' && running) { void requestWakeLock(); tick(); }
			});
			document.querySelectorAll<HTMLButtonElement>('.filters button').forEach(button => {
				button.addEventListener('click', () => {
					document.querySelectorAll<HTMLButtonElement>('.filters button').forEach(item => item.classList.remove('active'));
					button.classList.add('active');
					const filter = button.dataset.filter;
					document.querySelectorAll<HTMLElement>('.card').forEach(card => {
						card.hidden = filter !== 'Semua' && card.dataset.level !== filter;
					});
				});
			});
			goalSelect.addEventListener('change', () => {
				store.set(GOAL_KEY, goalSelect.value);
				updateProgress();
			});
			select<HTMLButtonElement>('#export-progress').addEventListener('click', () => {
				const payload = { goal: store.get<number>(GOAL_KEY, DEFAULT_GOAL), history: readHistory() };
				const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
				const link = document.createElement('a');
				link.href = URL.createObjectURL(blob);
				link.download = 'gerak-progress.json';
				link.click();
				URL.revokeObjectURL(link.href);
			});
			select<HTMLButtonElement>('#import-progress').addEventListener('click', () => importFile.click());
			importFile.addEventListener('change', async () => {
				const file = importFile.files?.[0];
				if (!file) return;
				try {
					const parsed = JSON.parse(await file.text()) as unknown;
					const incoming = sanitizeHistory(Array.isArray(parsed) ? parsed : (parsed as { history?: unknown }).history);
					if (incoming.length === 0) { historyStatus.textContent = 'Tidak ada data latihan yang bisa dibaca.'; return; }
					const merged = mergeHistory(readHistory(), incoming);
					store.set(HISTORY_KEY, JSON.stringify(merged));
					updateProgress();
					historyStatus.textContent = `${incoming.length} latihan diimpor.`;
				} catch {
					historyStatus.textContent = 'File tidak bisa dibaca.';
				} finally {
					importFile.value = '';
				}
			});
			select<HTMLButtonElement>('#reset-progress').addEventListener('click', () => {
				if (!confirm('Hapus semua progres latihan di perangkat ini? Tindakan ini tidak bisa dibatalkan.')) return;
				remove(weekKey(new Date()));
				remove(HISTORY_KEY);
				remove(LAST_WORKOUT_KEY);
				remove(LAST_PROGRAM_KEY);
				historyStatus.textContent = 'Progres dihapus.';
				updateProgress();
			});
			select<HTMLButtonElement>('#share-site').addEventListener('click', () => { void share('Workout di rumah tanpa alat — GERAK'); });
			if ('serviceWorker' in navigator) void navigator.serviceWorker.register('/sw.js').catch(() => {});

			const lastProgram = workouts.find(workout => workout.id === store.get<string | null>(LAST_PROGRAM_KEY, null));
			if (lastProgram) { selected = lastProgram; quickStartLabel.textContent = `Lanjutkan ${lastProgram.title}`; }
			else quickStartLabel.textContent = `Latihan cepat ${workouts[0].duration} menit`;
			renderMute();
			updateProgress();
		</script>
	</body>
</html>

